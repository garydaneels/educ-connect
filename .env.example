# Database
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_WEBHOOK_SECRET=your_webhook_secret_here
EMAIL_FROM=noreply@educ-connect.be
ADMIN_EMAIL=admin@educ-connect.be

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://yourdomain.com (for production)

# Cron Jobs
CRON_SECRET=your_cron_secret_here

# Optional: Google Analytics
NEXT_PUBLIC_ADSENSE_PUB_ID=your_adsense_id_here
